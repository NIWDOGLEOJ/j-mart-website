# Public frontend configuration only. Never place passwords, private keys, or
# database credentials in VITE_* variables; Vite exposes them to the browser.

# Leave blank in local development when the Vite /api proxy is used.
VITE_API_BASE_URL=

# Optional direct public inventory feed. Otherwise the website uses
# VITE_API_BASE_URL/api/products/public, then /inventory.json.
VITE_INVENTORY_API_URL=

# Optional sanitized loyalty feed. It must not contain private database fields.
VITE_CUSTOMER_FEED_URL=/loyalty-customers.json

# Optional WebSocket endpoint for instant stock-update notifications.
# Polling remains enabled when this is blank.
VITE_WS_URL=
